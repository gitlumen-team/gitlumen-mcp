# Optional: improves GitHub API rate limit for public repository screening.
# Create a fine-grained GitHub token with read-only public repo access.
GITHUB_TOKEN=

# Optional: data directory for generated reports.
# Default: ./.gitlumen-mcp
GITLUMEN_MCP_DATA_DIR=.gitlumen-mcp

# Optional: cap downloaded file content per file in bytes.
GITLUMEN_MAX_FILE_BYTES=120000

# Optional: only used by the Streamable HTTP transport (src/http.js).
# Default host/port for `npm run start:http`.
PORT=3333
HOST=0.0.0.0

# Optional: bearer token for the remote HTTP MCP endpoint.
# When set, clients must send `Authorization: Bearer <token>` to /mcp.
# Generate a long random value, e.g.: openssl rand -hex 32
MCP_AUTH_TOKEN=
