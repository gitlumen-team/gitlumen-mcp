{
  "servers": {
    "gitlumen": {
      "type": "stdio",
      "command": "node",
      "args": ["/ABSOLUTE/PATH/TO/gitlumen-mcp-server/src/index.js"],
      "env": {
        "GITHUB_TOKEN": "optional_github_token_here",
        "GITLUMEN_MCP_DATA_DIR": "/ABSOLUTE/PATH/TO/gitlumen-mcp-server/.gitlumen-mcp",
        "GITLUMEN_MAX_FILE_BYTES": "120000"
      }
    }
  }
}
